# Native (non-docker) runs — copy to .env and adjust.
# Inside docker compose, service hostnames postgres/redis are used instead.
DATABASE_URL=postgresql://telemetry:telemetry@localhost:5432/telemetry
REDIS_URL=redis://localhost:6379/0

# Worker tuning (optional)
WORKER_BATCH=100
WORKER_BLOCK_MS=1000
WORKER_RECOVERY_MIN_IDLE_MS=30000
